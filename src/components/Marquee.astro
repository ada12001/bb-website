---
// The track is two identical halves and scrolls -50% to loop seamlessly.
// Each half repeats the phrase set 3x so a single half is always wider than the
// viewport (even on ultrawide) — otherwise the loop shows a gap on wide screens.
// Phrases alternate between a hand-script face and the textured display face,
// matching the brand crawler treatment (peach bar, navy type, coral diamonds).
interface Item { t: string; font: "script" | "display"; }
interface Props { items?: Item[]; }
const { items = [
  { t: "The Bossier the Better", font: "script" },
  { t: "Since 1906", font: "display" },
  { t: "Respect the Pickles", font: "script" },
  { t: "No Such Thing as Too Many Pickles", font: "display" },
] } = Astro.props;
const half = [...items, ...items, ...items];
const loop = [...half, ...half];
---
<div class="marquee" aria-hidden="true" data-nav-theme="light">
  <div class="track">
    {loop.map((item) => (
      <>
        <span class={item.font}>{item.t}</span><span class="sep">&#10022;</span>
      </>
    ))}
  </div>
</div>
